PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/QuanLyMuonSach
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
FINE_PER_DAY=5000
# Render / Gemini: key stays on the server. Never put it in VITE_* or source control.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
# GEMINI_MODEL=gemini-2.5-flash
# Local alternative: AI_PROVIDER=ollama
# Optional: conversational AI via Ollama ON THIS SERVER ONLY (no remote host).
# For Ollama, history is sent only to this app and loopback Ollama.
# Without Ollama, Athena uses catalog descriptions and built-in library guidance.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Social login: server-only secrets. In production both origins must be the same HTTPS site.
# OAUTH_PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
# CLIENT_ORIGIN=https://YOUR-SERVICE.onrender.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
